# Copy these PUBLIC settings to Netlify Environment variables.
# Supabase Dashboard → Project Settings → API / Connect.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# NEVER expose service_role, sb_secret, or database password in NEXT_PUBLIC variables.
